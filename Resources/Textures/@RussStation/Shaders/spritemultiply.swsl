// Replicates Aseprite multiply blend as a semi-transparent black overlay.
// White mask areas = transparent (no effect). Dark mask areas = opaque black (darkens base).
// World-background-independent — no canvas blend mode used.

void fragment() {
    highp vec4 mask = zTexture(UV);
    highp float luma = dot(mask.rgb, vec3(0.299, 0.587, 0.114));
    highp float alpha = (1.0 - luma) * mask.a * VtxModulate.a;
    COLOR = vec4(0.0, 0.0, 0.0, alpha);
}
